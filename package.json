{
  "name": "channel-guard",
  "version": "0.2.1",
  "type": "module",
  "description": "DeepSeek Harness 渠道守卫：自动修复模型渠道「无法使用」——buddy 的 system 文本指纹、codearts 的 user-agent 拦截与失效请求头（含华为云签名重算），并如实诊断报告需要人工处理的部分。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib",
    "locale",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "test"
  ],
  "scripts": {
    "test": "node test/offline-check.mjs && node test/codearts-guard-check.mjs",
    "test:live": "node test/codearts-guard-check.mjs --live"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "channel",
    "diagnose",
    "repair"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shu-Tao/channel-guard.git"
  },
  "homepage": "https://github.com/Shu-Tao/channel-guard#readme",
  "bugs": {
    "url": "https://github.com/Shu-Tao/channel-guard/issues"
  }
}
